#!/bin/sh
# Deterministic git stub for the offline acceptance suite.  It never touches
# a real repository and prints canned output for the commands forge.git uses.

case " $* " in
  *" rev-parse "*)
    dirname "$PWD"
    ;;
  *" status "*)
    printf ' M src/main.c\n?? src/extra.c\n'
    ;;
  *" --cached "*)
    exit 0
    ;;
  *" diff "*)
    printf '@@ -1,3 +1,4 @@\n int a;\n-int b;\n+int B;\n int c;\n+int d;\n'
    ;;
  *" blame "*)
    i=1
    while [ "$i" -le 4 ]; do
      printf '1111111111111111111111111111111111111111 1 %d 1\n' "$i"
      printf 'author Alice\n'
      printf 'author-time 1700000000\n'
      printf 'summary initial commit\n'
      printf '\tline %d\n' "$i"
      i=$((i + 1))
    done
    ;;
esac
exit 0
